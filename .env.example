# Site (build time). Leave empty to run without the tally service.
VITE_API_URL=

# Tally service (server/). Never commit real values.
DATABASE_URL=postgres://localhost/lofs
ALLOWED_ORIGIN=http://localhost:5173
IP_SALT=replace-with-a-long-random-string
ADMIN_TOKEN=replace-with-a-long-random-string
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# PayPal: sandbox or mock only. live is refused by the server.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
REPORT_PRICE_USD=1.00

# Donkey Tracker (demo only). TRACKER=on switches it on; TRACKER_SECRET signs its email links.
TRACKER=
TRACKER_SECRET=
